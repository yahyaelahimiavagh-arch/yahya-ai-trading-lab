    "maximum_episodes": 10,
    "maximum_selected_per_epoch": 1,
    "minimum_separation_ms": 604800000,
    "source_state_epoch_ms": 2592000000,
    "source_state_epoch_anchor": "ANALYSIS_POOL_START",
