# Worker-side example. Keep the real file outside the repository.
YATL_NODE_ID=NODE-LAPTOP
YATL_COORDINATOR_TRANSPORT=ssh
YATL_SSH_HOST=REPLACE_WITH_VPS_HOST_OR_IP
YATL_SSH_USER=yatl-node
YATL_SSH_PORT=22
YATL_SSH_IDENTITY=/absolute/path/to/node-specific/id_ed25519
YATL_SSH_KNOWN_HOSTS=/absolute/path/to/yatl-known_hosts
YATL_WORKER_ROOT=/absolute/path/to/yatl-worker-state
YATL_DISTRIBUTED_PLAN=/absolute/path/to/plan.json
